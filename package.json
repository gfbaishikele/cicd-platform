{
  "name": "cicd-platform",
  "version": "1.0.0",
  "description": "Lightweight CI/CD platform with GitLab integration, Docker build, and multi-node deployment",
  "private": true,
  "scripts": {
    "dev": "nodemon server/index.js",
    "start": "node server/index.js",
    "client": "cd client && npm start",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\""
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.3",
    "pg": "^8.23.0",
    "socket.io": "^4.7.5",
    "sql.js": "^1.10.3",
    "ssh2": "^1.15.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.3"
  }
}
